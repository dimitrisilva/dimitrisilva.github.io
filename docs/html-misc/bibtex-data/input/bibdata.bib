@article{foster1988inequality,
  title = {Inequality and poverty orderings},
  author = {Foster, James E. and Shorrocks, Anthony F.},
  journal = {European Economic Review},
  volume = {32},
  number = {2-3},
  pages = {654--661},
  year = {1988},
  url = {https://www.sciencedirect.com/science/article/abs/pii/0014292188902127},
  doi = {10.1016/0014-2921(88)90212-7},
  publisher = {Elsevier},
  abstract = {We provide a brief review of both inequality and poverty orderings. We discuss Lorenz dominance. and show how the power of this ordering may be improved by imposing additional constraints on inequality measures. We give attention to the different types of ordering that can be constructed from poverty indices, and examine some of the relationships that exist between inequality and poverty orderings.}
}

@article{foster1988povertyi,
  title = {Poverty orderings},
  author = {Foster, James E. and Shorrocks, Anthony F.},
  journal = {Econometrica},
  volume = {56},
  number = {1},
  pages = {173--177},
  year = {1988},
  url = {https://www.jstor.org/stable/1911846},
  doi = {10.2307/1911846},
  publisher = {JSTOR}
}

@article{foster1988povertyii,
  title = {Poverty Orderings and Welfare Dominance},
  author = {Foster, James E. and Shorrocks, Anthony F.},
  journal = {Social Choice and Welfare},
  volume = {5},
  pages = {179--198},
  year = {1988},
  url = {https://link.springer.com/article/10.1007/BF00735760},
  doi = {10.1007/BF00735760},
  publisher = {Citeseer},
  abstract = {This paper examines the partial orderings of discrete distributions derived from various poverty indices and sets of welfare functions. The poverty ordering with respect to some index P is the ordering obtained when P ranks consistently over a range of admissible poverty lines. The poverty orderings derived from the headcount ratio, the per-capita income gap and another "distribution-sensitive" index are characterized in some detail when the poverty standard is allowed to take any positive value, and these orderings are shown to coincide with the natural interpretation of first, second and third degree "welfare dominance", respectively. Additional results are then obtained for the situation in which the admissible poverty lines cannot exceed some finite upper bound.}
}

@incollection{foster1990poverty,
  title = {Poverty Indices and Decomposability},
  author = {Foster, James E. and Shorrocks, Anthony F.},
  booktitle = {Contributions to Economic Analysis},
  volume = {195},
  editor = {Gareth D. Myles},
  pages = {109--129},
  year = {1990},
  publisher = {Elsevier},
  url = {https://www.sciencedirect.com/science/article/pii/B9780444885159500119},
  doi = {10.1016/B978-0-444-88515-9.50011-9},
  abstract = {This chapter discusses poverty indices and decomposability. It presents the desirable features of the FGT (Foster, Greer, and Thoerbecke) measures, and discusses that whether other types of indices also share these properties. All indices satisfy five restrictions commonly imposed on poverty indices--symmetry; replication invariance; the focus axiom; monotonicity; and continuity in the incomes of the poor. Overall poverty is a weighted average of subgroup poverty, with weights equal to the subgroup population shares. Decomposability is an attractive feature as it ensures that the overall poverty value will always move in the same direction as poverty levels within subgroups. In other words, if poverty increases within one subgroup, and remains the same elsewhere, then overall poverty must increase. This property is referred to as subgroup consistency. Subgroup consistency is a weaker condition than decomposability, and appears to be a highly desirable feature. The chapter also presents the implications of the subgroup consistency condition in the context of a poverty index.}
}

@article{foster1991subgroup,
  title = {Subgroup consistent poverty indices},
  author = {Foster, James E. and Shorrocks, Anthony F.},
  journal = {Econometrica},
  volume = {59},
  number = {3},
  pages = {687--709},
  year = {1991},
  url = {https://www.jstor.org/stable/2938224},
  doi = {10.2307/2938224},
  publisher = {JSTOR},
  abstract = {It seems desirable that the overall level of poverty should fall whenever poverty decreases within some subgroup of the population and is unchange outside that group. Yet this simple and attractive property, which we call "subgroup consistency", is violated by many of the poverty indices suggested in recent years. This paper characterizes the class of subgroup consistent poverty indices, and identifies the special features associated with this property.}
}

