  publisher = {Oxford University Press}
}

@article{celetani1996maintaining,
  title = {Maintaining a reputation against a long-lived opponent},
  author = {Celetani, Marco and Fudenberg, Drew and Levine, David K. and Pesendorfer, Wolfgang},
  journal = {Econometrica},
  volume = {64},
  number = {3},
