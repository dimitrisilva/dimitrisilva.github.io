  title = {Cultural Persistence or Experiential Adaptation? A Review of Studies Using Immigrants to Examine the Roots of Trust},
  author = {Dinesen, Peter Thisted and S\onderskov, Kim Mannemar},
  editor = {Eric M. Uslaner},
