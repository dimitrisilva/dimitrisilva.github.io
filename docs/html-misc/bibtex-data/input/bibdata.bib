  url = {https://pubsonline.informs.org/doi/abs/10.1287/moor.5.1.94},
  doi = {10.1287/moor.5.1.94},
  publisher = {INFORMS Institute for Operations Research and the Management Sciences}
}

@article{fishburn1982time,
  title = {Time preference},
  author = {Fishburn, Peter C. and Rubinstein, Ariel},
  journal = {International Economic Review},
  pages = {677--694},
  publisher = {JSTOR},
  year = {1982},
  doi = {10.2307/2526382},
