}

@article{bajraktarevic1969vergleichbarkeit,
  title = {\"{U}ber die Vergleichbarkeit der mit Gewichtsfunktionen gebildeten Mittelwerte},
  author = {Bajraktarevi\'{c}, Mahmut},
  journal = {Studia Scientiarum Mathematicarum Hungarica},
